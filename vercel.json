{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/m.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/_ds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/user", "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }] }
  ]
}

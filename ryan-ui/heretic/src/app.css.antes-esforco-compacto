/* Heretic — app de chat. Tokens do desenho "Heretic - App" (Claude Design). */
:root[data-theme="dark"] {
  /* Darkness: preto profundo e branco; vermelho claro só como acento (10%). */
  --background: #040405; --surface: #0A0A0C; --surface-raised: #0E0E11; --surface-muted: #121215; --surface-strong: #1A1A1E;
  --border: #19191D; --border-strong: #26262B; --border-subtle: #111114;
  /* Acento = osso, igual à landing (dono 17/11: "cor principal branca"). Antes era carmim #E8E2D0. */
  --accent: #E8E2D0; --accent-strong: #F4EFE2; --accent-subtle: #E8E2D024; --accent-foreground: #0A0A0B;
  --brand: #FFFFFF; --brand-strong: #FFFFFF; --brand-subtle: #ffffff0f;
  --chrome: linear-gradient(#FFFFFF, #FFFFFF);
  --chrome-edge: linear-gradient(180deg, #ffffff40, #ffffff0a 45%, #ffffff1c);
  --foreground: #F5F5F7; --text-secondary: #9A9AA3; --text-muted: #5E5E67;
  --success: #c9c9c9; --warning: #c9c9c9; --danger: #c9c9c9; --info: #c9c9c9; --focus-ring: #E8E2D0;
  --font-body: "Switzer", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Switzer", ui-sans-serif, system-ui, sans-serif; --font-serif: "Switzer", ui-sans-serif, system-ui, sans-serif;
  --text-xs: 13px; --text-sm: 13px; --text-base: 15px;
  --control-height-sm: 36px; --control-height-md: 40px; --control-height-lg: 48px; --radius-control: 12px;
}
* { box-sizing: border-box; }
html, body, #root { height: 100%; margin: 0; }
body { background: var(--background); color: var(--foreground); font: 400 15px/1.6 var(--font-body); letter-spacing: -.01em; -webkit-font-smoothing: antialiased; }
button { font: inherit; color: inherit; }
.full { width: 100%; justify-content: center; }

.app { position: relative; display: flex; height: 100dvh; overflow: hidden; background: var(--background); }

/* esquerda */
.side { flex: none; width: 0; overflow: hidden; transition: width .32s cubic-bezier(.2,.7,.2,1); }
.side-open .side { width: 264px; }
.side-in { display: flex; flex-direction: column; width: 264px; height: 100%; padding: 0 16px; }
.side-head { flex: none; display: flex; align-items: center; height: 64px; padding-left: 8px; }
.brand { display: flex; align-items: center; gap: 10px; color: var(--foreground); text-decoration: none; font: 600 17px/1 var(--font-display); letter-spacing: -.02em; }
.side-search { padding: 12px 0 4px; }
.side-search label:empty { display: none; }
.side-list { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; padding-top: 8px; }
.side-label { font-size: 13px; color: var(--text-muted); padding: 16px 10px 6px; }
.side-empty { font-size: 13px; color: var(--text-muted); padding: 12px 10px; margin: 0; }
.conv { position: relative; display: flex; align-items: center; }
.conv-open { position: relative; flex: 1; min-width: 0; height: 36px; padding: 0 10px; border: 0; border-radius: 10px; background: none; cursor: pointer; text-align: left; font-size: 14px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.conv-open:hover { background: #ffffff0a; color: var(--foreground); }
.conv.on .conv-open { color: var(--foreground); background: #ffffff08; }
.conv-dot { position: absolute; left: 1px; top: 15px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); opacity: 0; }
.conv.on .conv-dot { opacity: 1; }
.conv-del { position: absolute; right: 4px; height: 26px; padding: 0 8px; border: 0; border-radius: 8px; background: var(--surface-muted); color: var(--text-muted); font-size: 12px; cursor: pointer; opacity: 0; transition: opacity .2s; }
.conv:hover .conv-del, .conv-del:focus-visible { opacity: 1; }
.side-foot { flex: none; display: flex; align-items: center; height: 64px; }

/* centro */
.main { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; }
.main-glow { position: absolute; inset: 0 0 auto 0; height: 380px; background: radial-gradient(55% 90% at 50% -10%, #ffffff, transparent 70%); opacity: .045; pointer-events: none; }
.top { position: relative; flex: none; display: flex; align-items: center; gap: 12px; height: 64px; padding: 0 24px 0 12px; }
.top-title { flex: 1; min-width: 0; margin: 0; font: 600 17px/1.2 var(--font-display); letter-spacing: -.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.icon-btn { width: 40px; padding: 0; justify-content: center; }
.burger { display: grid; gap: 4px; width: 16px; }
.burger i { display: block; height: 1.5px; background: currentColor; border-radius: 1px; }

.empty { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 0 32px 40px; text-align: center; animation: rise .5s cubic-bezier(.2,.7,.2,1) both; }
.empty h2 { margin: 0; font: 600 48px/1 var(--font-display); letter-spacing: -.05em; }

.thread { position: relative; flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; padding: 0 32px; }
.col { width: 720px; max-width: 100%; margin: 0 auto; padding: 20px 0 40px; }
.u-row { margin-top: 28px; --accent: #141417; --accent-foreground: #F5F5F7; --text-sm: 15px; display: flex; justify-content: flex-end; animation: rise .35s cubic-bezier(.2,.7,.2,1) both; }
.u-row:first-child { margin-top: 0; }
.a-row { margin-top: 24px; animation: rise .35s cubic-bezier(.2,.7,.2,1) both; }
.rich p { margin: 0 0 12px; white-space: pre-wrap; }
.rich pre { margin: 0 0 12px; padding: 14px 16px; border-radius: 12px; background: var(--surface); box-shadow: inset 0 0 0 1px #ffffff12; overflow-x: auto; }
.rich code { font: 13px/1.6 "Geist Mono Variable", ui-monospace, monospace; white-space: pre; }
.edge { color: #3c3c44; }
.caret { display: inline-block; width: 7px; height: 1em; margin-left: 2px; vertical-align: -.14em; border-radius: 1px; background: var(--accent); }
.err { margin: 0; color: var(--text-secondary); }
.stats { display: flex; align-items: center; gap: 12px; margin-top: 4px; font-size: 13px; color: var(--text-muted); opacity: .7; }
.act { margin-left: auto; height: 28px; padding: 0 10px; border: 0; border-radius: 8px; background: none; color: var(--text-muted); cursor: pointer; opacity: 0; transition: opacity .25s; }
.a-row:hover .act, .act:focus-visible { opacity: 1; }
.act:hover { color: var(--foreground); background: #ffffff0a; }

/* compositor */
.dock { position: relative; flex: none; padding: 0 32px 14px; }
.dock-in { position: relative; width: 720px; max-width: 100%; margin: 0 auto; }
.chips { display: flex; justify-content: center; padding-bottom: 14px; --text-sm: 14px; }
.chips > * > :first-child:empty, .chips legend { display: none; }
.composer { border-radius: 20px; border: 1px solid transparent; background: linear-gradient(#08080A, #08080A) padding-box, var(--chrome-edge) border-box; box-shadow: 0 40px 90px -50px #000, 0 0 0 1px #00000080; }
.composer textarea { display: block; width: 100%; min-height: 58px; max-height: 40vh; padding: 16px 18px 4px; border: 0; outline: 0; resize: none; background: transparent; color: var(--foreground); font: 400 15px/1.5 var(--font-body); }
.composer textarea::placeholder { color: var(--text-muted); }
.bar { display: flex; align-items: center; gap: 6px; padding: 6px 10px 10px; }
.pills { flex: 1; min-width: 0; display: flex; gap: 6px; }
.pill-wrap { position: relative; display: inline-flex; flex: none; }
.pill { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border: 0; border-radius: 999px; background: #ffffff0d; box-shadow: inset 0 0 0 1px #ffffff1f; font-size: 13px; color: var(--text-secondary); cursor: pointer; white-space: nowrap; transition: background .2s, color .2s; }
.pill:hover { background: #ffffff17; color: var(--foreground); }
.pill.on { background: #ffffff10; box-shadow: inset 0 0 0 1px #ffffff3a; color: var(--foreground); }
.pill:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
.chev { font-size: 12px; line-height: 1; opacity: .6; transform: translateY(-2px); }
.send { flex: none; }
.hint { margin: 8px 6px 0; font-size: 13px; line-height: 1.4; color: var(--text-muted); }
.hint kbd { display: inline-block; min-width: 18px; margin-right: 6px; padding: 1px 5px; border-radius: 5px; box-shadow: inset 0 0 0 1px #ffffff24; font: 500 12px/1.4 "Geist Mono Variable", ui-monospace, monospace; text-align: center; color: var(--text-secondary); }

/* popover que sobe */
.pop { position: absolute; left: 0; bottom: calc(100% + 10px); z-index: 30; max-height: 420px; overflow-y: auto; padding: 8px; border-radius: 16px; background: var(--surface-raised); box-shadow: 0 0 0 1px #ffffff17, 0 30px 60px -20px #000; animation: popIn .18s cubic-bezier(.2,.7,.2,1) both; }
.pop-search { padding: 0 0 6px; }
.pop-search label:empty { display: none; }
.pop-list { display: flex; flex-direction: column; gap: 2px; }
.opt { display: flex; align-items: center; gap: 12px; width: 100%; padding: 8px 10px; border: 0; border-radius: 12px; background: none; text-align: left; cursor: pointer; }
.opt:hover, .opt:focus-visible { background: #ffffff0d; outline: 0; }
.opt-ico { flex: none; display: grid; place-items: center; width: 32px; height: 32px; }
.opt-txt { flex: 1; min-width: 0; }
.opt-txt strong { display: block; font: 600 14px/1.3 var(--font-body); }
.opt-txt span { display: block; font-size: 13px; line-height: 1.35; color: var(--text-secondary); }
.opt-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); opacity: 0; }
.opt[aria-selected="true"] .opt-dot { opacity: 1; }
.opts { display: flex; flex-direction: column; gap: 18px; padding: 8px 6px; }

/* direita: sessão */
.sess { flex: none; width: 0; overflow: hidden; transition: width .32s cubic-bezier(.2,.7,.2,1); }
.sess-open .sess { width: 280px; }
.sess-in { display: flex; flex-direction: column; gap: 22px; width: 280px; padding: 96px 32px 0 8px; font-size: 14px; --accent: #8a8a8a; }
.sess-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.sess-row span:first-child { color: var(--text-muted); }

/* folha de baixo (celular) */
.sheet-backdrop { position: fixed; inset: 0; z-index: 40; background: #000000a6; animation: fade .2s both; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; max-height: 78dvh; overflow-y: auto; padding: 8px 14px calc(16px + env(safe-area-inset-bottom)); border-radius: 22px 22px 0 0; background: var(--surface-raised); box-shadow: 0 -1px 0 #ffffff17; animation: sheetUp .28s cubic-bezier(.2,.7,.2,1) both; }
.sheet-grip { width: 40px; height: 4px; margin: 4px auto 10px; border-radius: 2px; background: #ffffff2e; }
.sheet-title { padding: 2px 8px 10px; font: 600 15px/1.2 var(--font-display); }
.sheet .opt { min-height: 52px; }

@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes popIn { from { opacity: 0; transform: translateY(6px) scale(.98); } to { opacity: 1; transform: none; } }
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: none; } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }

/* celular */
@media (max-width: 820px) {
  .side { position: fixed; inset: 0 auto 0 0; z-index: 41; width: 0; background: var(--background); }
  .side-open .side { width: min(86vw, 300px); box-shadow: 1px 0 0 #ffffff12; }
  .side-in { width: min(86vw, 300px); padding-top: env(safe-area-inset-top); }
  .top { height: calc(56px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 10px 0 6px; }
  .top-title { text-align: center; font-size: 16px; }
  .thread { padding: 0 16px; }
  .col { padding: 12px 0 24px; }
  .empty h2 { font-size: 38px; }
  .dock { padding: 0 10px calc(10px + env(safe-area-inset-bottom)); }
  .chips { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
  .pills { overflow-x: auto; scrollbar-width: none; }
  .pill { height: 36px; }
  .composer textarea { font-size: 16px; }
  .sess { position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; width: auto; height: 0; transition: height .3s cubic-bezier(.2,.7,.2,1); background: var(--surface-raised); border-radius: 22px 22px 0 0; }
  .sess-open .sess { width: auto; height: auto; }
  .sess-in { width: 100%; padding: 16px 20px calc(20px + env(safe-area-inset-bottom)); --accent: #8a8a8a; }
  .conv-del { opacity: 1; }
}

/* ── darkness: granulado, vinheta, títulos em branco ── */
.app::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background: radial-gradient(120% 90% at 50% 0%, transparent 40%, #000000b3 100%); }
.app::after { content: ""; position: absolute; inset: 0; z-index: 60; pointer-events: none; background: repeating-linear-gradient(0deg, #ffffff04 0 1px, transparent 1px 3px); }
.app { isolation: isolate; }
.empty h2, .brand span { background: var(--chrome); -webkit-background-clip: text; background-clip: text; color: transparent; }
.empty h2 { font-family: var(--font-serif); font-weight: 600; font-size: 64px; letter-spacing: -.045em; line-height: 1; filter: drop-shadow(0 10px 30px #000); }
.side-open .side { border-right: 1px solid #ffffff08; }
.sess-open .sess { border-left: 1px solid #ffffff08; }
.pop, .sheet { background: linear-gradient(180deg, #111114, #0A0A0C); box-shadow: 0 0 0 1px #ffffff14, inset 0 1px 0 #ffffff12, 0 40px 80px -30px #000; }
.u-row [class*="bubble"] { box-shadow: inset 0 0 0 1px #ffffff12, inset 0 1px 0 #ffffff10; }

/* ── compositor em duas linhas, voz e topo do celular (desenho "Heretic - App Mobile") ── */
.row1 { display: flex; align-items: flex-end; gap: 4px; }
.row1 textarea { flex: 1; min-width: 0; }
.send { display: flex; align-items: center; gap: 6px; }
.dict-on { display: grid; place-items: center; width: 44px; height: 32px; padding: 0; border: 0; border-radius: 10px; background: #ffffff0a; cursor: pointer; }
.voice-hold { flex: none; height: 32px; padding: 0 12px; border: 0; border-radius: 10px; background: none; color: var(--text-secondary); font-size: 14px; cursor: pointer; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.voice-hold:active { background: #ffffff12; color: var(--foreground); }
.listening { position: absolute; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 0 28px; background: #040405f2; text-align: center; pointer-events: none; animation: fade .2s both; }
.listening-title { margin: 8px 0 0; font: 600 24px/1.2 var(--font-display); letter-spacing: -.03em; }
.listening-sub { margin: 0; max-width: 320px; font-size: 16px; line-height: 1.45; color: var(--text-secondary); }
.top-title-btn { flex: 1; min-width: 0; display: grid; justify-items: center; gap: 1px; padding: 4px 6px; border: 0; border-radius: 12px; background: none; cursor: pointer; }
.top-title-btn:active { background: #ffffff0a; }
.top-sub { font-size: 12px; line-height: 1.3; color: var(--text-muted); }

@media (max-width: 820px) {
  .composer { border-radius: 22px; }
  .row1 { padding: 6px 6px 0 4px; align-items: center; }
  .row1 textarea { min-height: 44px; height: 44px; padding: 10px; font-size: 16px; }
  .bar { padding: 6px 8px 8px; }
  .pills { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); padding-right: 24px; }
  .top-title-btn .top-title { max-width: 206px; font-size: 15px; line-height: 1.25; text-align: center; }
  .empty { gap: 16px; padding: 0 24px; }
  .empty h2 { font-size: 40px; }
  .chips { margin: 0 -10px 10px; padding: 0 10px; }
}
@media (max-width: 820px) {
  .chips > * { width: max-content; }
  .chips * { flex-wrap: nowrap !important; }
}

/* ── tema hacker (dono, 15/11): terminal, cursor e glitch ── */
.empty h2::after { content: "_"; margin-left: .04em; color: var(--accent); -webkit-text-fill-color: var(--accent); animation: hxBlink 1s steps(1) infinite; }
.empty h2 { animation: hxGlitch 11s infinite; }
@keyframes hxBlink { 50% { opacity: 0; } }
@keyframes hxGlitch { 0%, 95%, 100% { transform: none; } 96% { transform: translate(-2px, 1px) skewX(-4deg); } 97% { transform: translate(2px, -1px); } 98% { transform: none; } }
.brand img { display: block; }
@media (prefers-reduced-motion: reduce) { .empty h2, .empty h2::after { animation: none; } }

/* ── microinterações (Framer): mola curta; mono só em rótulos e código ── */
.top-sub, .side-label, .stats, .hint, kbd, code, pre { font-family: "Geist Mono Variable", ui-monospace, monospace; }
button { transition: transform .22s cubic-bezier(.34,1.56,.64,1), background-color .2s ease, box-shadow .2s ease, color .2s ease; }
button:active:not(:disabled) { transform: scale(.96); transition-duration: .08s; }
.pill:hover, .opt:hover { transform: translateY(-1px); }
@media (prefers-reduced-motion: reduce) { button, .pill:hover, .opt:hover { transform: none !important; transition: none !important; } }

/* ── onboarding (Duolingo): progresso, cards grandes, uma decisão por passo ── */
.onb { position: relative; flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; width: 720px; max-width: 100%; margin: 0 auto; padding: 24px 32px 24px; box-sizing: border-box; animation: rise .4s cubic-bezier(.2,.7,.2,1) both; }
.onb-top { display: flex; align-items: center; gap: 16px; }
.onb-bar { flex: 1; height: 8px; border-radius: 99px; background: #ffffff10; overflow: hidden; }
.onb-bar i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width .5s cubic-bezier(.34,1.56,.64,1); }
.onb-skip { border: 0; background: none; color: var(--text-muted); font-size: 14px; cursor: pointer; padding: 6px 4px; }
.onb-skip:hover { color: var(--foreground); }
.onb-kicker { margin: 40px 0 8px; font: 500 12px/1 "Geist Mono Variable", ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
.onb-title { margin: 0 0 24px; font: 600 32px/1.1 var(--font-display); letter-spacing: -.035em; }
.onb-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.onb-card { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: center; padding: 14px 16px; border: 0; border-radius: 14px; background: #0E0E11; box-shadow: inset 0 0 0 1px #ffffff14, 0 3px 0 #ffffff0d; text-align: left; cursor: pointer; }
.onb-card > :first-child { grid-row: span 2; }
.onb-card strong { font-size: 15px; }
.onb-card span { font-size: 13px; line-height: 1.4; color: var(--text-secondary); }
.onb-card:hover { box-shadow: inset 0 0 0 1px var(--accent), 0 3px 0 #E8E2D040; transform: translateY(-2px); }
.onb-list { display: flex; flex-direction: column; gap: 10px; }
.onb-q { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; border: 0; border-radius: 14px; background: #0E0E11; box-shadow: inset 0 0 0 1px #ffffff14, 0 3px 0 #ffffff0d; font-size: 15px; text-align: left; cursor: pointer; }
.onb-q:hover { box-shadow: inset 0 0 0 1px var(--accent), 0 3px 0 #E8E2D040; transform: translateY(-2px); }
.onb-q span:last-child { color: var(--accent); }
.onb-back { align-self: flex-start; margin-top: 18px; border: 0; background: none; color: var(--text-secondary); font-size: 14px; cursor: pointer; }
.onb-done { margin: 0; font-size: 15px; color: var(--text-secondary); animation: rise .4s both; }
.onb-done b { color: var(--accent); font-weight: 600; }
@media (max-width: 820px) {
  .onb { padding: 12px 16px 16px; }
  .onb-kicker { margin-top: 24px; }
  .onb-title { font-size: 26px; margin-bottom: 18px; }
  .onb-card { padding: 12px; }
}

/* ── tipografia igual ao drael.sh (dono, 15/11): Instrument Serif 400 nos títulos, Switzer 400/500 no texto ── */
:root, :root[data-theme="dark"] { --font-display: "Instrument Serif", Georgia, serif; --font-serif: "Instrument Serif", Georgia, serif; }
body { letter-spacing: -.02em; }
.empty h2 { font-family: var(--font-serif); font-weight: 400; font-size: 72px; letter-spacing: -.02em; line-height: 1; }
.onb-title { font: 400 40px/1.05 var(--font-serif); letter-spacing: -.02em; }
.listening-title { font: 400 30px/1.1 var(--font-serif); letter-spacing: -.02em; }
.brand, .top-title, .sheet-title { font-family: var(--font-body); font-weight: 500; }
.opt-txt strong, .onb-done b, b, strong { font-weight: 500; }

/* ── mesmo padrão da landing (dono, 15/11 21h): preto + prata, verde só no acento, máscara prata, títulos em serifa prata, texto fino, cartões estilo terminal ── */
/* Mini cigarra da marca no lugar da máscara antiga (direitos de terceiros): prata nos grátis, osso nos Pro e no avatar. */
.mask { display: inline-block; flex: none; background: #8A8A90; -webkit-mask: url(/icons/cigarra-mini.svg) center / contain no-repeat; mask: url(/icons/cigarra-mini.svg) center / contain no-repeat; }
.mask[data-pro] { background: #E8E2D0; }
/* Cigarra mascarada (dono 17/11): a mesma logo, pintável e com brilho cromado em movimento. */
.hx-cicada { display: block; flex: none; background: var(--cic, var(--accent)); -webkit-mask: url(/icons/cicada.png) center / contain no-repeat; mask: url(/icons/cicada.png) center / contain no-repeat; }
.hx-cicada-chrome { background: linear-gradient(100deg, #5E5E66 0%, #FFFFFF 16%, #E8E2D0 32%, #9A9AA3 50%, #FFFFFF 70%, #6E6E76 86%, #5E5E66 100%); background-size: 300% 100%; animation: hxChrome 4.2s linear infinite; }
.hx-avatar-cic { background: transparent !important; box-shadow: none !important; }
.hx-avatar-cic .hx-cicada { filter: drop-shadow(0 0 5px color-mix(in srgb, var(--cic, #fff) 35%, transparent)); }
